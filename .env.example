# Copiá este archivo a `.env` y completalo antes de `docker compose up`.
# En desarrollo no hace falta nada de esto: `npm run dev` anda tal cual.

# ------------------------------------------------------------------ básico

# Tu dominio, sin https://
DOMAIN=poker.midominio.com

# La misma URL pero completa. Google la usa para volver después del login.
PUBLIC_URL=https://poker.midominio.com

# IP pública del VPS. coturn la necesita para anunciar por dónde se lo alcanza.
SERVER_IP=203.0.113.10

# Clave de las sesiones. Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Dónde vive la base. TIENE que estar en un volumen que sobreviva al despliegue:
# si apunta al directorio de la aplicación, las cuentas se borran cada vez que
# publicás. En producción el servidor no arranca si falta.
DATABASE_FILE=/data/puker.db

# ------------------------------------------------- login con Google (opcional)

# Se saca en https://console.cloud.google.com/apis/credentials
#   1. Creá un proyecto
#   2. "Crear credenciales" -> "ID de cliente de OAuth" -> Aplicación web
#   3. En "URI de redireccionamiento autorizados" poné EXACTAMENTE:
#      https://poker.midominio.com/api/auth/google/callback
# Si los dejás vacíos, el botón de Google no aparece y se entra solo con
# usuario y contraseña.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------ voz (TURN)

# Secreto compartido con coturn. Generalo igual que SESSION_SECRET.
# Sin esto el audio falla para quien esté con datos móviles (CGNAT).
TURN_SECRET=

# Cómo llegan los navegadores al TURN. El `turns:` sobre 5349 sirve cuando una
# red solo deja salir por puertos de TLS.
TURN_URLS=turn:poker.midominio.com:3478,turns:poker.midominio.com:5349

# Cuántos segundos vale cada credencial temporal de TURN.
TURN_TTL_SEC=14400

# -------------------------------------------------------------- opcionales

# Servidores STUN. Los de Google y Cloudflare son gratis y alcanzan.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

# Días que dura la sesión antes de pedir login de nuevo.
# SESSION_DAYS=30
